# Server Configuration
PORT=4000
NODE_ENV=development

# Authentication
JWT_SECRET=super-secret-jwt-key-chapterwhisper-change-in-production
JWT_EXPIRES_IN=7d

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Storage Directory (relative to server root or absolute path)
STORAGE_DIR=./data
