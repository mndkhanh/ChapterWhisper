# ---------------------------------------------------------------------------
# Client configuration. Copy to `client/.env` — that copy is gitignored.
#
# Two different consumers live in here, and the distinction matters:
#   BACKEND_URL    read by vite.config.ts, in Node, at dev-server startup.
#   VITE_*         inlined into the browser bundle at build time. NEVER put a
#                  secret in a VITE_ var — it ships to every visitor.
# ---------------------------------------------------------------------------

# Where Vite forwards /api during `npm run dev` and `npm run preview`.
# Must match the server's PORT (see server/.env).
BACKEND_URL=http://localhost:4000

# Port the Vite dev server binds.
CLIENT_PORT=3000

# Absolute base for API calls made by the browser.
# Leave EMPTY for normal development. Empty means the client calls relative
# `/api/...` paths, Vite proxies them, and the session cookie stays same-origin
# — which is what makes the httpOnly cookie work without CORS.
# Only set this to bypass the proxy (e.g. a deployed API on another host), and
# note the server must then allow that origin with credentials.
VITE_API_BASE=
